# ---- Obrigatórias ----
DATABASE_URL=postgres://app:app@localhost:5432/agenda
APP_URL=http://localhost:3000
# string aleatória longa (>=32 chars): openssl rand -base64 48
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# ---- WhatsApp Business Platform (API oficial da Meta) ----
# disabled = nada é enviado, jobs ficam "pendentes" (padrão)
# test     = NÃO envia; registra como "test_sent" (modo de teste identificado)
# cloud    = envia de verdade via Cloud API (exige credenciais abaixo)
WHATSAPP_MODE=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# ---- E-mail transacional (opcional; Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Agenda <no-reply@seudominio.com.br>

# ---- Operação ----
HEALTH_TOKEN=
SENTRY_DSN=
